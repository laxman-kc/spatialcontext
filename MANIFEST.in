include README.md ARCHITECTURE.md REPORT.md PLAN.md PROGRESS.md CONTRIBUTING.md
include requirements-figures.txt
recursive-include configs *.yaml
recursive-include scripts *.py *.sh *.html
recursive-include tests *.py
recursive-include explorer *.html *.css *.js
